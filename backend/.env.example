DATABASE_URL=sqlite:///./ormangozu.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ONLINE_TIMEOUT_SECONDS=30
# Legacy IP-based wake-up is disabled for the offline pilot.
ENABLE_HTTP_WHISPER=0

# Local pilot UI/collector token. Generate a random long value; keep the API on localhost.
# Distinct long, random strings (do not reuse these for mesh or OTA signing).
OG_CLIENT_TOKEN=CHANGE_ME_COLLECTOR_RANDOM_32PLUS
OG_OPERATOR_TOKEN=CHANGE_ME_OPERATOR_RANDOM_32PLUS
OG_ENABLE_LEGACY_SENSOR_HTTP=0
OG_ENABLE_API_DOCS=0
OG_PILOT_DB=./pilot_events.sqlite3
